# Sade-inspired chord loop: 
# playNote(note, beats = ...) format from Week 03 seminar slides (UTS, 2026)
# sustain option seen in code TunePad generated when I recorded notes
# beats=0 was found in learn tunepad guide
# Note choices: my own, built from the white keys of C major
# Piano chords repeated 7 times (7 x 16 beats = 112 beats, about 67 seconds at 100 bpm)
for j in range(7):
    playNote(57, beats=0, sustain=4)
    playNote(60, beats=0, sustain=4)
    playNote(64, beats=0, sustain=4)
    playNote(67, beats=4)

    playNote(57, beats=0, sustain=4)
    playNote(60, beats=0, sustain=4)
    playNote(62, beats=0, sustain=4)
    playNote(65, beats=4)

    playNote(55, beats=0, sustain=4)
    playNote(59, beats=0, sustain=4)
    playNote(62, beats=0, sustain=4)
